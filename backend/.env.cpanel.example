# cPanel shared hosting — copy to `.env` on the server (File Manager) and fill in the blanks.
# Differs from .env.example: MySQL on localhost, no Redis (database cache/session/queue),
# local public disk for media, real domains. Replace USER with the cPanel account username.

APP_NAME=Ali
APP_ENV=production
# Generated by `php artisan key:generate --force` during the one-time setup (DEPLOY_CPANEL.md).
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.alirasouli.info

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# cPanel prefixes these with the account name, e.g. USER_portfolio.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# No Redis on shared hosting. The API response cache switches itself off without tag
# support (App\Support\ContentCache); Next.js keeps its own cache anyway.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Processed by the `queue:work --stop-when-empty` cron job every minute.
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.alirasouli.info
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@alirasouli.info"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_TO_ADDRESS="hello@alirasouli.info"

# Same value in the Node.js App's environment variables (openssl rand -hex 32).
API_INTERNAL_KEY=
API_CACHE_TTL=86400

FRONTEND_URL=https://alirasouli.info

# Laravel POSTs {NEXT_URL}/api/revalidate with this secret; same value on the Node.js App.
NEXT_URL=https://alirasouli.info
REVALIDATE_SECRET=

TURNSTILE_SECRET_KEY=

ADMIN_NAME=Ali
ADMIN_EMAIL=ali.rasouli.webdeveloper@gmail.com
ADMIN_2FA_REQUIRED=true
# Only read by the first `db:seed`; clear it from this file afterwards.
ADMIN_PASSWORD=

# Mock content for the first `db:seed` (shipped inside backend.zip by the deploy workflow).
SEED_PATH=/home/USER/api.alirasouli.info/seed
ASSETS_PATH=/home/USER/api.alirasouli.info/assets/images

# --- Deploys (DEPLOY_CPANEL.md) ---
# Manual trigger: POST https://api.alirasouli.info/deploy-hook with header X-Deploy-Token.
DEPLOY_WEBHOOK_SECRET=
# Optional for this public repo, but recommended: a fine-grained PAT (Contents: read-only)
# lifts GitHub's 60 requests/hour anonymous limit shared by everyone on this server's IP.
DEPLOY_GITHUB_TOKEN=
# Absolute path of the Next.js Node.js App root, e.g. /home/USER/alirasouli.info
DEPLOY_FRONTEND_PATH=

GSC_ENABLED=false
GSC_SITE_URL=
GSC_PAGE_BASE_URL=
GSC_CREDENTIALS_PATH=

SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.2
