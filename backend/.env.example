APP_NAME=Ali
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ali_portfolio
DB_USERNAME=ali_portfolio
DB_PASSWORD=ali_portfolio

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@alicodes.dev"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_TO_ADDRESS="hello@alicodes.dev"

# Shared secret Next.js must send as X-Internal-Key on every /api/v1 request
API_INTERNAL_KEY=change-me
API_CACHE_TTL=86400

# Next.js origin allowed to call the public /uploads endpoint directly (CORS)
FRONTEND_URL=http://localhost:3000

# POSTed to {NEXT_URL}/api/revalidate with this bearer secret after content changes
NEXT_URL=http://web:3000
REVALIDATE_SECRET=change-me

# Cloudflare Turnstile (server-side siteverify)
TURNSTILE_SECRET_KEY=change-me

# Filament admin user created by the seeder (set a strong password)
ADMIN_NAME=Ali
ADMIN_EMAIL=admin@alicodes.dev
ADMIN_2FA_REQUIRED=false
ADMIN_PASSWORD=

# Mock content used by the database seeder (mounted into the container by docker-compose)
SEED_PATH=/var/www/seed
ASSETS_PATH=/var/www/assets/images

# Google Search Console (optional, feeds the live SEO panel). Needs a service account JSON with access to the property.
GSC_ENABLED=false
GSC_SITE_URL=
GSC_PAGE_BASE_URL=
GSC_CREDENTIALS_PATH=
