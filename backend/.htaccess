# cPanel: the subdomain's document root is the app root, so every request is served from public/.
# The redirect of /public/... addresses lives in public/.htaccess (that folder's rules win there).
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
