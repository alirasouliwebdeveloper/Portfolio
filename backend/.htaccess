# cPanel: the subdomain's document root is the app root, so every request is served from public/.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # public/ is an internal detail: a browser asking for /public/... (e.g. /public/admin) is sent
    # to the clean address. THE_REQUEST is the original request line, so the internal rewrite
    # below never matches it and there is no loop.
    RewriteCond %{THE_REQUEST} \s/+public(?:/([^\s?]*))?[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L,NE]

    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
