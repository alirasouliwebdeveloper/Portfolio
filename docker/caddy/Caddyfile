# Public website (Next.js)
www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

{$SITE_DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000
}

# Laravel: admin panel, media files and the public upload/contact API
{$API_DOMAIN} {
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow"
	request_body {
		max_size 12MB
	}
	reverse_proxy nginx:80
}
