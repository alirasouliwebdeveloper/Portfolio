# Copy to .env on the server and fill in every value. Never commit the real file.

# --- Domains (DNS A records must point at this server) ---
SITE_DOMAIN=example.com
API_DOMAIN=api.example.com
ACME_EMAIL=you@example.com

# --- Laravel ---
APP_NAME=Ali
# php artisan key:generate --show   (or: echo "base64:$(openssl rand -base64 32)")
APP_KEY=
ADMIN_NAME=Ali
ADMIN_EMAIL=you@example.com
# Only used by the first `db:seed`. The admin panel then asks for 2FA (ADMIN_2FA_REQUIRED).
ADMIN_PASSWORD=
ADMIN_2FA_REQUIRED=true

# --- Secrets shared between services (openssl rand -hex 32) ---
API_INTERNAL_KEY=
REVALIDATE_SECRET=
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
REDIS_PASSWORD=

# --- Cloudflare Turnstile (dashboard.cloudflare.com -> Turnstile) ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Mail (SMTP): contact notifications and auto-replies ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SCHEME=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_TO_ADDRESS=hello@example.com

# --- Optional ---
# Local loopback port used while building the web image
API_LOCAL_PORT=8080
BACKUP_RETENTION_DAYS=14
BACKUP_AT=03:30
TZ=UTC
GSC_ENABLED=false
GSC_SITE_URL=
GSC_PAGE_BASE_URL=

# Error monitoring (sentry.io project DSN). Leave blank to disable — nothing is sent, no account needed.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.2
